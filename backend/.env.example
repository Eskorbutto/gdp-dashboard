# Copiar a .env y completar. Nunca subir .env al repositorio.

# Conexión de la aplicación: rol SIN privilegios (no dueño de tablas, sin BYPASSRLS).
DATABASE_URL=postgresql+psycopg://cc_app:CAMBIAR@localhost:5432/callcenter

# Conexión para migraciones y carga de datos simulados: rol dueño del esquema.
DATABASE_URL_OWNER=postgresql+psycopg://cc_owner:CAMBIAR@localhost:5432/callcenter

# Nombre del rol de aplicación al que las migraciones otorgan permisos.
APP_DB_ROLE=cc_app

# Clave para firmar los tokens de sesión (generar con: python -c "import secrets; print(secrets.token_urlsafe(48))").
SECRET_KEY=CAMBIAR

TOKEN_MINUTOS=480
